  "excludedFamilies": [
    {
      "name": "internal-sales-and-operations",
      "tablePatterns": [
        "^agent_store(?:_record)?$", "^channel_store_relation$", "^cooperation_consult$",
        "^return_visit$", "^trial_user_record$", "^user_trial_record$",
        "^user_track(?:_black)?$", "^store_growth_event$"
      ]
    },
    {
      "name": "credential-and-password",
      "tablePatterns": ["^(?:card|coupon)_password$", "^store_platform_auth_token$"]
    },
    {
      "name": "legacy-copy-tables",
      "tablePatterns": [
        "^card_template_copy$", "^store_added_services01$", "^store_sms_template_copy[12]$"
      ]
    }
